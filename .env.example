# Every key stays in this file. Do not delete a line to "skip" it.
# Paste secrets locally. Never paste PAYOUT_WALLET_PRIVATE_KEY or PRIVATE_KEY in chat.
# PRODUCTION stays 0 until Nishant green-lights. Local E2E does not flip it.
# Vercel production: ASOC_ADDRESS + PRIVATE_KEY + WEBHOOK_SECRET as secrets.
# Keep DRY_RUN=1 and PRODUCTION=0 until the 1-token mint/stake/1-hour claim lands.

# Polygon — mainnet, not Amoy
POLYGON_RPC=https://polygon-rpc.com
POLYGON_MAINNET_RPC=https://polygon-rpc.com
ASOC_ADDRESS=
HAUL_LEDGER_ADDRESS=
PRIVATE_KEY=

# Payout — separate Base-only pipe
PAYOUT_CHAIN=base
PAYOUT_WALLET_PRIVATE_KEY=
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
DRIVER_PAYOUT_ADDRESS=
DRY_RUN=1
NOTIFICATIONS_DRY_RUN=1
GPS_PROOF_REQUIRED=1

# Base — driver USDC payout network
BASE_RPC=https://sepolia.base.org
BASE_MAINNET_RPC=https://mainnet.base.org

# App
WEBHOOK_SECRET=change-me
SESSION_SECRET=
ALCHEMY_API_KEY=
ALCHEMY_WEBHOOK_SIGNING_KEY=
PORT=3001
PRODUCTION=0
PUBLIC_BASE_URL=http://localhost:3001
MATCH_RADIUS_MILES=50

# Data
DATABASE_URL=postgres://asoc:asoc@localhost:5432/asoc

# Email / SMS — blank is ok for local E2E
RESEND_API_KEY=
EMAIL_FROM=receipts@americashipsonclick.example
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
GOOGLE_MAPS_API_KEY=

# Bots — blank is ok until Gemini rebuild
DISPATCH_NOTIFY_URL=
BOT_SCRIBE_URL=
BOT_FRONT_DESK_URL=
BOT_CIRCUIT_URL=
BOT_SCOUT_URL=
BOT_ANCHOR_URL=
BOT_COMMANDER_URL=
BOT_COINSTALL_URL=

# Local E2E driver (Hardhat account 1). Swap wallet before a mainnet USDC fire.
TEST_DRIVER_ID=test-driver-1
TEST_DRIVER_WALLET=0x70997970C51812dc3A010C7d01b50e0d17dc79C8

{
  "name": "asoc-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "ASOC Web3 backend: Polygon mint/stake, Base USDC payouts, haul ledger, Alchemy webhooks, Postgres",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "api": "tsx src/index.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx scripts/seed-loads.ts",
    "db:up": "tsx scripts/local-postgres.ts",
    "phase1": "hardhat run scripts/phase1-local.ts",
    "phase1:mainnet:control": "hardhat run scripts/phase1-mainnet-control.ts --network polygon",
    "phase1:mainnet:claim": "hardhat run scripts/phase1-mainnet-claim.ts --network polygon",
    "env:check": "tsx scripts/check-env.ts",
    "vercel:prod-env": "tsx scripts/vercel-prod-env.ts",
    "e2e:local": "hardhat test test/e2e-load-payout.test.ts",
    "e2e:node": "hardhat node --hostname 127.0.0.1 --port 8545",
    "e2e:deploy": "hardhat run scripts/deploy-e2e-local.ts --network localhost",
    "deploy:polygon": "hardhat run scripts/deploy-polygon.ts --network polygonAmoy",
    "deploy:asoc:mainnet": "hardhat run scripts/deploy-asoc-mainnet.ts --network polygon",
    "deploy:polygon:mainnet": "hardhat run scripts/deploy-asoc-mainnet.ts --network polygon",
    "deploy:base": "hardhat run scripts/deploy-base.ts --network baseSepolia",
    "deploy:base:mainnet": "hardhat run scripts/deploy-base.ts --network base"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "embedded-postgres": "^18.4.0-beta.17",
    "hardhat": "^2.22.18",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
